# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase --------------------------------------------------------------
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Same page, "service_role". Bypasses RLS — server-side only, never exposed to
# the browser. Used by signup and the seed script.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Access ----------------------------------------------------------------
# The shared code that gates signup. Anything you like — pick something your
# group will remember and outsiders won't guess.
INVITE_CODE=squat-rack-4eva

# --- Push notifications ----------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
# The public key ships to the browser; the private key goes to Supabase Edge
# Function secrets, NOT here (it is listed for reference only).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=B...
